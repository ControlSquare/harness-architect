{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://controlsquare.com/schemas/platform-adapter.schema.json",
  "title": "Harness platform adapter manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "version",
    "kind",
    "operations",
    "auth",
    "idempotent"
  ],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "kind": {
      "enum": ["publishing", "storage", "images", "search"]
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "auth": {
      "enum": ["none", "api_key", "oauth", "session"]
    },
    "idempotent": {
      "type": "boolean"
    },
    "notes": {
      "type": "string"
    }
  }
}
